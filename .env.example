# Copie para .env e ajuste. Valores apenas para uso LOCAL de demonstração.
POSTGRES_DB=orderflow
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow-local-dev

# Dados de demonstração (usuários e produtos DEMO-*). As senhas viram hash BCrypt no banco.
DEMO_DATA_ENABLED=true
DEMO_ADMIN_PASSWORD=Admin@Demo2026
DEMO_OPERATOR_PASSWORD=Operador@Demo2026

# Retentativas do consumidor de pagamento (falhas temporárias do gateway simulado).
PAYMENT_RETRY_INTERVAL_MS=1000
PAYMENT_MAX_RETRIES=3
